generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  position String
  phone    String?

  hourlyRate   Float  @default(0) @map("hourly_rate")
  paymentBasis String @default("Monthly") @map("payment_basis")

  // Employee authentication and profile
  password         String?   @map("password") // Hashed password for employee portal
  profilePicture   String?   @map("profile_picture") // Profile image URL
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  nationalId       String?   @unique @map("national_id")
  address          String?
  emergencyContact String?   @map("emergency_contact")
  emergencyPhone   String?   @map("emergency_phone")

  // Employment details
  hireDate   DateTime? @map("hire_date") @db.Date
  department String?
  manager    String? // Could be linked to another employee later
  employeeId String?   @unique @map("employee_id") // Company employee ID

  // Access and permissions
  isActive              Boolean @default(true) @map("is_active")
  canAccessPortal       Boolean @default(true) @map("can_access_portal")
  canWorkRemotely       Boolean @default(false) @map("can_work_remotely")
  primaryWorkLocationId Int?    @map("primary_work_location_id") // Primary work location

  // Session tracking
  lastLoginAt          DateTime? @map("last_login_at")
  lastActiveAt         DateTime? @map("last_active_at")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  // Preferences
  preferredLanguage  String  @default("en") @map("preferred_language")
  timezone           String  @default("Africa/Cairo")
  emailNotifications Boolean @default(true) @map("email_notifications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendance           Attendance[]
  payouts              Payout[]
  sessions             EmployeeSession[]
  checkInRequests      CheckInRequest[]
  primaryWorkLocation  WorkLocation?          @relation("EmployeePrimaryLocation", fields: [primaryWorkLocationId], references: [id])
  allowedWorkLocations EmployeeWorkLocation[]

  @@map("employees")
}

// Junction table for many-to-many relationship between employees and work locations
model EmployeeWorkLocation {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @map("employee_id")
  workLocationId Int      @map("work_location_id")
  canCheckIn     Boolean  @default(true) @map("can_check_in")
  canCheckOut    Boolean  @default(true) @map("can_check_out")
  isActive       Boolean  @default(true) @map("is_active")
  assignedAt     DateTime @default(now()) @map("assigned_at")
  assignedBy     String?  @map("assigned_by") // Admin who assigned this location

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workLocation WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workLocationId])
  @@map("employee_work_locations")
}

model WorkLocation {
  id           Int     @id @default(autoincrement())
  name         String
  address      String
  latitude     Float
  longitude    Float
  radiusMeters Int     @default(100) @map("radius_meters") // Geofence radius in meters
  isActive     Boolean @default(true) @map("is_active")
  timezone     String  @default("Africa/Cairo")
  description  String? // Optional description of the location

  // Working hours for this location (can override system defaults)
  workingHoursStart String? @map("working_hours_start")
  workingHoursEnd   String? @map("working_hours_end")

  // Location management
  createdBy String? @map("created_by") // Admin who created this location

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checkInRequests     CheckInRequest[]
  attendanceRecords   Attendance[]
  employeeAssignments EmployeeWorkLocation[]
  primaryEmployees    Employee[]             @relation("EmployeePrimaryLocation")

  @@map("work_locations")
}

model EmployeeSession {
  id         String  @id @default(cuid())
  employeeId Int     @map("employee_id")
  token      String  @unique // Session token
  deviceInfo String? @map("device_info") // Browser/device information
  ipAddress  String? @map("ip_address")
  userAgent  String? @map("user_agent")

  isActive   Boolean  @default(true) @map("is_active")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  // Location permissions for check-ins
  locationPermission Boolean @default(false) @map("location_permission")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_sessions")
}

model CheckInRequest {
  id             Int  @id @default(autoincrement())
  employeeId     Int  @map("employee_id")
  workLocationId Int? @map("work_location_id")

  // Location data
  latitude  Float
  longitude Float
  accuracy  Float? // GPS accuracy in meters
  address   String? // Reverse geocoded address

  // Check-in/out details
  type      String // "CHECK_IN", "CHECK_OUT"
  timestamp DateTime @default(now())

  // Verification status
  status String @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "AUTO_APPROVED"

  // Distance verification
  distanceFromLocation Float?  @map("distance_from_location") // Distance in meters from work location
  isWithinGeofence     Boolean @default(false) @map("is_within_geofence")

  // Photo verification (optional)
  photoUrl String? @map("photo_url")

  // Processing details
  processedAt     DateTime? @map("processed_at")
  processedBy     String?   @map("processed_by") // "AUTO" or admin user ID
  rejectionReason String?   @map("rejection_reason")

  // Device info
  deviceId  String? @map("device_id")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])

  @@map("check_in_requests")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Attendance {
  id             Int       @id @default(autoincrement())
  employeeId     Int       @map("employee_id")
  workLocationId Int?      @map("work_location_id") // New: link to work location
  date           DateTime  @db.Date
  checkIn        DateTime  @map("check_in")
  checkOut       DateTime? @map("check_out")
  hoursWorked    Float?    @map("hours_worked")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  isPaidDay      Boolean   @default(true) @map("is_paid_day")

  // Location verification
  checkInLocationVerified  Boolean @default(false) @map("check_in_location_verified")
  checkOutLocationVerified Boolean @default(false) @map("check_out_location_verified")
  checkInRequestId         Int?    @map("check_in_request_id") // Link to the check-in request
  checkOutRequestId        Int?    @map("check_out_request_id") // Link to the check-out request

  // Remote work tracking
  isRemoteWork         Boolean @default(false) @map("is_remote_work")
  remoteWorkReason     String? @map("remote_work_reason")
  remoteWorkApprovedBy String? @map("remote_work_approved_by")

  // Existing deduction tracking fields
  actualHoursWorked   Float @default(0) @map("actual_hours_worked")
  lateDeductionHours  Float @default(0) @map("late_deduction_hours")
  earlyDeductionHours Float @default(0) @map("early_deduction_hours")

  // Existing penalty tracking fields
  graceMinutesUsed       Int   @default(0) @map("grace_minutes_used")
  lateMinutesBeyondGrace Int   @default(0) @map("late_minutes_beyond_grace")
  makeupTimeRequired     Float @default(0) @map("makeup_time_required")
  makeupTimeCompleted    Float @default(0) @map("makeup_time_completed")
  totalPenaltyAmount     Float @default(0) @map("total_penalty_amount")

  employee     Employee            @relation(fields: [employeeId], references: [id])
  workLocation WorkLocation?       @relation(fields: [workLocationId], references: [id])
  penalties    AttendancePenalty[]

  @@unique([employeeId, date])
  @@map("attendance")
}

model AttendancePenalty {
  id           Int    @id @default(autoincrement())
  attendanceId Int    @map("attendance_id")
  penaltyType  String @map("penalty_type") // "LATE_ARRIVAL", "EARLY_DEPARTURE", "MISSED_HOURS", "UNPAID_DAY"
  severity     String @map("severity") // "GRACE_PERIOD", "MINOR", "MODERATE", "MAJOR", "FULL_DAY"
  description  String

  // Time-related fields
  lateMinutes  Int?   @map("late_minutes")
  earlyMinutes Int?   @map("early_minutes")
  missedHours  Float? @map("missed_hours")

  // Penalty calculation fields
  hoursDeducted  Float   @default(0) @map("hours_deducted")
  salaryDeducted Float   @default(0) @map("salary_deducted")
  makeupRequired Boolean @default(false) @map("makeup_required")
  makeupHours    Float   @default(0) @map("makeup_hours")

  // Status tracking
  isActive     Boolean   @default(true) @map("is_active")
  isWaived     Boolean   @default(false) @map("is_waived")
  waivedReason String?   @map("waived_reason")
  waivedBy     String?   @map("waived_by")
  waivedAt     DateTime? @map("waived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_penalties")
}

model Payout {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  amount           Float     @default(0)
  isPaid           Boolean   @default(false) @map("is_paid")
  comment          String?
  paymentDate      DateTime? @map("payment_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  adjustmentAmount Float?    @default(0) @map("adjustment_amount")
  adjustmentReason String?   @map("adjustment_reason")
  includeOvertime  Boolean   @default(false) @map("include_overtime")

  // Detailed breakdown fields
  daysWorked          Int   @default(0) @map("days_worked")
  unpaidDays          Int   @default(0) @map("unpaid_days")
  totalHours          Float @default(0) @map("total_hours")
  regularHours        Float @default(0) @map("regular_hours")
  overtimeHours       Float @default(0) @map("overtime_hours")
  excessOvertimeHours Float @default(0) @map("excess_overtime_hours")
  basePayout          Float @default(0) @map("base_payout")
  overtimePayout      Float @default(0) @map("overtime_payout")
  finalAmount         Float @default(0) @map("final_amount")

  // Deduction tracking fields
  grossSalary          Float @default(0) @map("gross_salary") // Total salary before deductions
  lateDeductions       Float @default(0) @map("late_deductions")
  earlyDeductions      Float @default(0) @map("early_deductions")
  unpaidDaysDeductions Float @default(0) @map("unpaid_days_deductions")
  totalDeductions      Float @default(0) @map("total_deductions")
  holidayHours         Float @default(0) @map("holiday_hours")
  holidayPayout        Float @default(0) @map("holiday_payout")

  employee    Employee           @relation(fields: [employeeId], references: [id])
  adjustments PayoutAdjustment[]

  @@unique([employeeId, periodStart, periodEnd])
  @@map("payouts")
}

model PayoutAdjustment {
  id        Int      @id @default(autoincrement())
  payoutId  Int      @map("payout_id")
  type      String // "bonus", "deduction", "overtime", "other"
  amount    Float
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  payout    Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("payout_adjustments")
}

model SystemSettings {
  id                        Int     @id @default(autoincrement())
  lateAllowanceMinutes      Int     @default(30) @map("late_allowance_minutes")
  workDaySunday             Boolean @default(true) @map("work_day_sunday")
  workDayMonday             Boolean @default(true) @map("work_day_monday")
  workDayTuesday            Boolean @default(true) @map("work_day_tuesday")
  workDayWednesday          Boolean @default(true) @map("work_day_wednesday")
  workDayThursday           Boolean @default(true) @map("work_day_thursday")
  workDayFriday             Boolean @default(false) @map("work_day_friday")
  workDaySaturday           Boolean @default(true) @map("work_day_saturday")
  workingHoursPerDay        Float   @default(9) @map("working_hours_per_day")
  workingHoursStart         String  @default("09:00") @map("working_hours_start")
  workingHoursEnd           String  @default("18:00") @map("working_hours_end")
  overtimeMultiplier        Float   @default(1.5) @map("overtime_multiplier")
  weekendOvertimeMultiplier Float   @default(2) @map("weekend_overtime_multiplier")

  // Penalty Configuration (lateAllowanceMinutes above serves as grace period)
  penaltyMinor30Min       Int     @default(60) @map("penalty_minor_30min") // 1 hour deduction for up to 30 min beyond grace
  penaltyModerate90Min    Int     @default(180) @map("penalty_moderate_90min") // 3 hours deduction for up to 90 min beyond grace
  penaltyMajor150Min      Float   @default(0.5) @map("penalty_major_150min") // Half day for up to 150 min beyond grace
  penaltyFullDay          Float   @default(1.0) @map("penalty_full_day") // Full day for 150+ min beyond grace
  allowMakeupTime         Boolean @default(true) @map("allow_makeup_time")
  makeupTimeDeadlineHours Int     @default(24) @map("makeup_time_deadline_hours")

  // Location-based attendance settings
  enableLocationTracking    Boolean @default(true) @map("enable_location_tracking")
  defaultGeofenceRadius     Int     @default(100) @map("default_geofence_radius") // meters
  autoApproveWithinGeofence Boolean @default(true) @map("auto_approve_within_geofence")
  requirePhotoVerification  Boolean @default(false) @map("require_photo_verification")
  allowRemoteWork           Boolean @default(false) @map("allow_remote_work")
  maxCheckInRequestsPerDay  Int     @default(10) @map("max_check_in_requests_per_day")

  // Employee portal settings
  enableEmployeePortal        Boolean @default(true) @map("enable_employee_portal")
  requireStrongPassword       Boolean @default(true) @map("require_strong_password")
  passwordMinLength           Int     @default(8) @map("password_min_length")
  sessionTimeoutMinutes       Int     @default(480) @map("session_timeout_minutes") // 8 hours
  maxActiveDevicesPerEmployee Int     @default(3) @map("max_active_devices_per_employee")
  allowPasswordReset          Boolean @default(true) @map("allow_password_reset")
  requireEmailVerification    Boolean @default(false) @map("require_email_verification")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
