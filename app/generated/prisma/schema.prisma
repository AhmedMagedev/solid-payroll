generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  position      String
  phone         String?
  fingerprintId String?      @map("fingerprint_id")
  hourlyRate    Float        @default(0) @map("hourly_rate")
  paymentBasis  String       @default("Daily") @map("payment_basis")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  attendance    Attendance[]
  payouts       Payout[]

  @@map("employees")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  date        DateTime  @db.Date
  checkIn     DateTime  @map("check_in")
  checkOut    DateTime? @map("check_out")
  hoursWorked Float?    @map("hours_worked")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isPaidDay   Boolean   @default(true) @map("is_paid_day")

  // Deduction tracking fields
  actualHoursWorked   Float @default(0) @map("actual_hours_worked")
  lateDeductionHours  Float @default(0) @map("late_deduction_hours")
  earlyDeductionHours Float @default(0) @map("early_deduction_hours")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendance")
}

model Payout {
  id               Int       @id @default(autoincrement())
  employeeId       Int       @map("employee_id")
  periodStart      DateTime  @map("period_start") @db.Date
  periodEnd        DateTime  @map("period_end") @db.Date
  amount           Float     @default(0)
  isPaid           Boolean   @default(false) @map("is_paid")
  comment          String?
  paymentDate      DateTime? @map("payment_date")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  adjustmentAmount Float?    @default(0) @map("adjustment_amount")
  adjustmentReason String?   @map("adjustment_reason")
  includeOvertime  Boolean   @default(false) @map("include_overtime")

  // Detailed breakdown fields
  daysWorked          Int   @default(0) @map("days_worked")
  unpaidDays          Int   @default(0) @map("unpaid_days")
  totalHours          Float @default(0) @map("total_hours")
  regularHours        Float @default(0) @map("regular_hours")
  overtimeHours       Float @default(0) @map("overtime_hours")
  excessOvertimeHours Float @default(0) @map("excess_overtime_hours")
  basePayout          Float @default(0) @map("base_payout")
  overtimePayout      Float @default(0) @map("overtime_payout")
  finalAmount         Float @default(0) @map("final_amount")

  // Deduction tracking fields
  grossSalary          Float @default(0) @map("gross_salary") // Total salary before deductions
  lateDeductions       Float @default(0) @map("late_deductions")
  earlyDeductions      Float @default(0) @map("early_deductions")
  unpaidDaysDeductions Float @default(0) @map("unpaid_days_deductions")
  totalDeductions      Float @default(0) @map("total_deductions")
  holidayHours         Float @default(0) @map("holiday_hours")
  holidayPayout        Float @default(0) @map("holiday_payout")

  employee    Employee           @relation(fields: [employeeId], references: [id])
  adjustments PayoutAdjustment[]

  @@unique([employeeId, periodStart, periodEnd])
  @@map("payouts")
}

model PayoutAdjustment {
  id        Int      @id @default(autoincrement())
  payoutId  Int      @map("payout_id")
  type      String // "bonus", "deduction", "overtime", "other"
  amount    Float
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  payout    Payout   @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("payout_adjustments")
}

model SystemSettings {
  id                        Int      @id @default(autoincrement())
  lateAllowanceMinutes      Int      @default(30) @map("late_allowance_minutes")
  workDaySunday             Boolean  @default(true) @map("work_day_sunday")
  workDayMonday             Boolean  @default(true) @map("work_day_monday")
  workDayTuesday            Boolean  @default(true) @map("work_day_tuesday")
  workDayWednesday          Boolean  @default(true) @map("work_day_wednesday")
  workDayThursday           Boolean  @default(true) @map("work_day_thursday")
  workDayFriday             Boolean  @default(false) @map("work_day_friday")
  workDaySaturday           Boolean  @default(true) @map("work_day_saturday")
  workingHoursPerDay        Float    @default(9) @map("working_hours_per_day")
  workingHoursStart         String   @default("09:00") @map("working_hours_start")
  workingHoursEnd           String   @default("18:00") @map("working_hours_end")
  overtimeMultiplier        Float    @default(1.5) @map("overtime_multiplier")
  weekendOvertimeMultiplier Float    @default(2) @map("weekend_overtime_multiplier")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
